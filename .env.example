NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Holdings (scripts/ingest-holdings.ts) — FinAPI, not mfdata
INGEST_HOLDINGS_LIMIT=0
INGEST_HOLDINGS_MONTHS=12
INGEST_HOLDINGS_DELAY_MS=250
INGEST_HOLDINGS_SKIP_EXISTING=1

FINAPI_API_KEY=your_finapi_pro_key
FINAPI_BASE=https://finapi.upvaly.com

# Optional: after ingest, drop Next/CDN caches (app must be running)
APP_URL=http://localhost:3000
REVALIDATE_SECRET=choose-a-long-random-string
INGEST_METRICS_PAGE_SIZE=50
INGEST_METRICS_MAX_PAGES=0
INGEST_METRICS_DELAY_MS=150
